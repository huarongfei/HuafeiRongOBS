diff --git a/frontend/widgets/HFRPpt.cpp b/frontend/widgets/HFRPpt.cpp
index 27dd848..2f02bf1 100644
--- a/frontend/widgets/HFRPpt.cpp
+++ b/frontend/widgets/HFRPpt.cpp
@@ -6,6 +6,7 @@
 #include <QUrl>
 
 #include <obs-module.h>
+#include <obs-frontend-api.h>
 
 #ifdef HFR_ENABLE_PPT
 /* LOK 的 paintTile/getParts/postUnoCommand 等成员受此宏保护 */
@@ -215,6 +216,20 @@ bool HFRPptDocument::RenderCurrentPart(uint32_t, uint32_t, std::vector<uint8_t>
 
 /* ================================ HFRPpt ================================ */
 
+QString HfrPptTestOutputDir()
+{
+	char *p = obs_frontend_get_current_profile_path();
+	QString dir = p ? QString::fromUtf8(p) : QString();
+	if (p) {
+		bfree(p);
+	}
+	if (dir.isEmpty()) {
+		dir = QDir::tempPath();
+	}
+	QDir().mkpath(dir);
+	return dir;
+}
+
 HFRPpt &HFRPpt::Instance()
 {
 	static HFRPpt inst;
@@ -412,4 +427,4 @@ bool HFRPpt::RenderToBmpForTest(uint32_t w, uint32_t h, const QString &bmpPath,
 				    .arg(PartCount());
 	}
 	return true;
-}
+}
\ No newline at end of file
diff --git a/frontend/widgets/HFRPpt.hpp b/frontend/widgets/HFRPpt.hpp
index 7daf728..d868918 100644
