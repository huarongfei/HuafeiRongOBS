 	return true;
 }
 
+bool HFRPptDocument::RenderPart(int index, uint32_t w, uint32_t h, std::vector<uint8_t> &bgraOut, QString *errOut)
+{
+	if (!doc) {
+		if (errOut) {
+			*errOut = QStringLiteral("尚未打开 PPT");
+		}
+		return false;
+	}
+	const int saved = CurrentPart();
+	if (index < 0 || index >= partCount) {
+		return false;
+	}
+	if (!SetPart(index)) {
+		return false;
+	}
+	const bool ok = RenderCurrentPart(w, h, bgraOut, errOut);
+	if (saved >= 0) {
+		SetPart(saved);
+	}
+	return ok;
+}
+
+QString HFRPptDocument::NotesText() const
+{
+	if (!doc) {
+		return QString();
+	}
+	LibreOfficeKitDocument *d = (LibreOfficeKitDocument *)doc;
+	if (!d->pClass->getCommandValues) {
+		return QString();
+	}
+	/* 尽力尝试几个常见命令；不同版本支持情况不同，取不到就返回空串 */
+	const char *cmds[] = {".uno:PresentationNotes", ".uno:SlideNotes", ".uno:Notes"};
+	for (const char *cmd : cmds) {
+		char *v = d->pClass->getCommandValues(d, cmd);
+		if (!v) {
+			continue;
+		}
+		QString s = QString::fromUtf8(v);
+		/* LOK 返回 JSON 或纯文本；如果像 JSON 就粗略抽取 "text" 字段 */
+		if (s.startsWith(QLatin1Char('{')) || s.startsWith(QLatin1Char('['))) {
+			const int k = s.indexOf(QStringLiteral("\"text\""));
+			if (k >= 0) {
+				const int c1 = s.indexOf(QLatin1Char(':'), k);
+				const int q1 = s.indexOf(QLatin1Char('"'), c1 + 1);
+				const int q2 = s.indexOf(QLatin1Char('"'), q1 + 1);
+				if (q1 > 0 && q2 > q1) {
+					s = s.mid(q1 + 1, q2 - q1 - 1);
+				}
+			} else {
+				s.clear();
+			}
+		}
+		/* 释放 LOK 返回的字符串：freeError 定义在 Kit 类上 */
+		if (LibreOfficeKit *k = (LibreOfficeKit *)HFRPpt::Instance().Kit()) {
+			if (k->pClass && k->pClass->freeError) {
+				k->pClass->freeError(v);
+			}
+		}
+		if (!s.trimmed().isEmpty()) {
+			return s;
+		}
+	}
+	return QString();
+}
+
 #else /* !HFR_ENABLE_PPT */
 
