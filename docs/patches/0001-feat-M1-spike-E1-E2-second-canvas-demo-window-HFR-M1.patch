 #include <QWidgetAction>
 
 #include <mutex>
@@ -1030,6 +1034,21 @@ void OBSBasic::OBSInit()
 	InitHotkeys();
 	ui->preview->Init();
 
+	/* HFR M1 spike (temporary): second-canvas demos */
+	{
+		blog(LOG_INFO, "[HFR] obsinit: registering HFR(M1) menu, env_auto=%d",
+		     (int)qEnvironmentVariableIsSet("HFR_E1_AUTO"));
+		QMenu *hfrMenu = new QMenu(QStringLiteral("HFR(M1)"), this);
+		QAction *e1Act = hfrMenu->addAction(QStringLiteral("E1: 第二画布窗口（克隆演示）"));
+		QAction *e2Act = hfrMenu->addAction(QStringLiteral("E2: 第二画布窗口（独立色块）"));
+		connect(e1Act, &QAction::triggered, this, []() { HFRCanvasWindow::OpenE1(); });
+		connect(e2Act, &QAction::triggered, this, []() { HFRCanvasWindow::OpenE2(); });
+		menuBar()->addMenu(hfrMenu);
+		if (qEnvironmentVariableIsSet("HFR_E1_AUTO")) {
+			QTimer::singleShot(4000, []() { HFRCanvasWindow::OpenE1(); });
+		}
+	}
+
 	/* hack to prevent elgato from loading its own QtNetwork that it tries
 	 * to ship with */
 #if defined(_WIN32) && !defined(_DEBUG)
