@@ -6,41 +6,60 @@
 
 /* ============================================================
  * HFRPpt —— 同进程 LibreOfficeKit（LOK）演示文档（pptx）渲染
- * 设计要点（产品方要求）：
- *   - 本地化部署 LibreOffice，**不走 IPC 桥接**：直接加载 program/mergedlo.dll，
- *     通过导出符号 lok_preinit_2 取得 LibreOfficeKit*，同进程调用其 vtable。
- *   - 动画：LOK 为静态渲染，一期按"每页最终状态"呈现（页间用自建转场）。
- *   - 文字：按目标分辨率整页渲染；后续加"缺失字体报告/替换表"与 2x 超采样。
- * 编译开关：HFR_ENABLE_PPT=ON 时才启用（未启用时接口返回失败并给出提示）。
+ *   - HFRPpt         : 全局 Kitty（加载 mergedlo.dll + lok_preinit_2），单例
+ *   - HFRPptDocument : 单个文档实例（可多开：每个 PPT 来源一个）
+ *   - 无 IPC 桥接；动画按"每页最终态"呈现（一期策略，见 docs/PPT-方案.md）
  * ============================================================ */
+
+class HFRPptDocument {
+public:
+	HFRPptDocument() = default;
+	~HFRPptDocument();
+	HFRPptDocument(const HFRPptDocument &) = delete;
+	HFRPptDocument &operator=(const HFRPptDocument &) = delete;
+
+	bool Open(const QString &pptxPath, QString *errOut);
+	void Close();
+	bool IsOpen() const { return doc != nullptr; }
+
+	int PartCount() const { return partCount; }
+	int CurrentPart() const;
+	bool SetPart(int index);
+	bool NextPart();
+	bool PrevPart();
+
+	/* 整页渲染为 BGRA（自顶向下，每像素 4 字节） */
+	bool RenderCurrentPart(uint32_t w, uint32_t h, std::vector<uint8_t> &bgraOut, QString *errOut);
+
+private:
+	void *doc = nullptr;
+	int partCount = 0;
+};
+
 class HFRPpt {
