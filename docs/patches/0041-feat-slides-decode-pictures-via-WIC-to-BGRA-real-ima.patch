+				const int sy = (int)((int64_t)y * it.texH / std::max(1, it.h));
+				for (int x = 0; x < it.w; x++) {
+					const int sx = (int)((int64_t)x * it.texW / std::max(1, it.w));
+					const size_t si = ((size_t)sy * (size_t)it.texW + (size_t)sx) * 4;
