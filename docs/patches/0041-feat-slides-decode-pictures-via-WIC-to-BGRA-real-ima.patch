+					const uint32_t c = 0xFF000000u | ((uint32_t)it.pix[si + 2] << 16) |
+							   ((uint32_t)it.pix[si + 1] << 8) | (uint32_t)it.pix[si + 0];
+					BlendPixel(bgra, W, it.x + x, it.y + y, c, 255);
+				}
+			}
 		} else if (it.kind == ItemKind::Picture || it.kind == ItemKind::Table) {
