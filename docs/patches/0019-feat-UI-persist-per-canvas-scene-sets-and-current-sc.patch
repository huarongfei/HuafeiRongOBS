-		w = ovi.base_width;
-		h = ovi.base_height;
-	}
-
-	obs_data_t *s = obs_data_create();
-	obs_data_set_int(s, "color", 0xFF00C8FF);
-	obs_data_set_int(s, "width", (long long)w);
-	obs_data_set_int(s, "height", (long long)h);
-	const QByteArray scn = obs_source_get_name(scSrc);
-	obs_source_t *cs = obs_source_create("color_source_v3", (scn + " · 色块").constData(), s, nullptr);
-	obs_data_release(s);
-	if (!cs) {
