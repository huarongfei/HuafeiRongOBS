+#include "HFRPpt.hpp"
+
+#include <QDir>
+#include <QFile>
+#include <QFileInfo>
+#include <QUrl>
+
+#include <obs-module.h>
+
+#ifdef HFR_ENABLE_PPT
+/* LOK 的 paintTile/getParts/postUnoCommand 等成员受此宏保护 */
+#define LOK_USE_UNSTABLE_API 1
+#include <LibreOfficeKit/LibreOfficeKit.h>
+#include <LibreOfficeKit/LibreOfficeKitEnums.h>
+#include <windows.h>
+
+typedef int (*LokHookPreInit2)(const char *install_path, const char *user_profile_url, LibreOfficeKit **kit);
+#endif
+
+HFRPpt &HFRPpt::Instance()
+{
+	static HFRPpt inst;
+	return inst;
+}
+
+QString HFRPpt::DefaultLoPath()
+{
+	const QByteArray env = qgetenv("HFR_LO_PATH");
+	if (!env.isEmpty()) {
+		return QString::fromLocal8Bit(env);
+	}
+	return QStringLiteral("D:/HuafeirongOBS/tools/LibreOffice");
+}
+
+HFRPpt::~HFRPpt()
+{
+	CloseDocument();
+}
+
+bool HFRPpt::Enabled() const
+{
+#ifdef HFR_ENABLE_PPT
+	return true;
+#else
+	return false;
+#endif
+}
+
+#ifdef HFR_ENABLE_PPT
+
+static bool PathToFileUrl(const QString &path, QString *urlOut)
+{
+	if (path.isEmpty()) {
+		return false;
+	}
+	QString u = QUrl::fromLocalFile(path).toString();
+	if (!u.endsWith(QLatin1Char('/')) && QFileInfo(path).isDir()) {
+		u += QLatin1Char('/');
+	}
+	*urlOut = u;
+	return true;
+}
+
+bool HFRPpt::EnsureLoaded(QString *errOut)
+{
+	if (kit) {
+		return true;
+	}
+	const QString loPath = DefaultLoPath();
+	const QString dllPath = loPath + QStringLiteral("/program/mergedlo.dll");
+	if (!QFile::exists(dllPath)) {
+		lastError = QStringLiteral("未找到 LibreOffice：%1（可用环境变量 HFR_LO_PATH 指定安装根目录）").arg(dllPath);
+		if (errOut) {
+			*errOut = lastError;
+		}
+		return false;
+	}
+
+	const std::wstring wdll = QDir::toNativeSeparators(dllPath).toStdWString();
+	HMODULE h = LoadLibraryW(wdll.c_str());
+	if (!h) {
+		lastError = QStringLiteral("加载 mergedlo.dll 失败（错误码 %1）").arg(GetLastError());
+		if (errOut) {
+			*errOut = lastError;
+		}
+		return false;
+	}
+	LokHookPreInit2 preinit = (LokHookPreInit2)GetProcAddress(h, "lok_preinit_2");
+	if (!preinit) {
+		FreeLibrary(h);
+		lastError = QStringLiteral("mergedlo.dll 未导出 lok_preinit_2（该版本不支持 LOK？）");
+		if (errOut) {
+			*errOut = lastError;
+		}
+		return false;
+	}
+
+	QString installUrl, profileUrl;
+	PathToFileUrl(loPath, &installUrl);
+	const QString profileDir = loPath + QStringLiteral("/hfr-lok-profile");
+	QDir().mkpath(profileDir);
+	PathToFileUrl(profileDir, &profileUrl);
+
+	LibreOfficeKit *k = nullptr;
+	const int ret = preinit(installUrl.toUtf8().constData(), profileUrl.toUtf8().constData(), &k);
+	if (ret != 0 || !k) {
+		FreeLibrary(h);
+		lastError = QStringLiteral("lok_preinit_2 失败（ret=%1）").arg(ret);
+		if (errOut) {
+			*errOut = lastError;
+		}
+		return false;
+	}
+
+	libHandle = (void *)h;
+	kit = (void *)k;
+
+	/* 中文界面/字体回退相关的基础选项（后续可扩展为可配置） */
+	if (k->pClass && k->pClass->setOption) {
+		k->pClass->setOption(k, "locale", "zh-CN");
+	}
+	blog(LOG_INFO, "[HFR-PPT] LibreOffice LOK 已加载：%s", loPath.toUtf8().constData());
+	return true;
+}
+
+bool HFRPpt::OpenDocument(const QString &pptxPath, QString *errOut)
+{
+	if (!EnsureLoaded(errOut)) {
+		return false;
+	}
+	if (!QFile::exists(pptxPath)) {
+		lastError = QStringLiteral("文件不存在：%1").arg(pptxPath);
+		if (errOut) {
+			*errOut = lastError;
+		}
+		return false;
+	}
+	CloseDocument();
+
+	QString url;
+	PathToFileUrl(pptxPath, &url);
+	LibreOfficeKit *k = (LibreOfficeKit *)kit;
+	LibreOfficeKitDocument *d = k->pClass->documentLoad(k, url.toUtf8().constData());
+	if (!d) {
+		const char *e = k->pClass->getError ? k->pClass->getError(k) : nullptr;
+		lastError = QStringLiteral("载入文档失败：%1").arg(e ? QString::fromUtf8(e) : QStringLiteral("未知"));
+		if (errOut) {
+			*errOut = lastError;
+		}
+		return false;
+	}
+	doc = (void *)d;
+	openedPath = pptxPath;
+
+	if (d->pClass->initializeForRendering) {
+		d->pClass->initializeForRendering(d, nullptr);
+	}
+	partCount = d->pClass->getParts ? d->pClass->getParts(d) : 1;
+	if (partCount <= 0) {
+		partCount = 1;
+	}
+	blog(LOG_INFO, "[HFR-PPT] 已载入：%s，共 %d 页", QFileInfo(pptxPath).fileName().toUtf8().constData(), partCount);
+	return true;
+}
+
+void HFRPpt::CloseDocument()
+{
+	if (doc) {
+		LibreOfficeKitDocument *d = (LibreOfficeKitDocument *)doc;
+		if (d->pClass && d->pClass->destroy) {
+			d->pClass->destroy(d);
+		}
+		doc = nullptr;
+	}
+	openedPath.clear();
+	partCount = 0;
+}
+
+bool HFRPpt::IsOpen() const
+{
+	return doc != nullptr;
+}
+
+int HFRPpt::PartCount() const
+{
+	return partCount;
+}
+
+int HFRPpt::CurrentPart() const
+{
+	if (!doc) {
+		return -1;
+	}
+	LibreOfficeKitDocument *d = (LibreOfficeKitDocument *)doc;
+	return d->pClass->getPart ? d->pClass->getPart(d) : 0;
+}
+
+bool HFRPpt::SetPart(int index)
+{
+	if (!doc || index < 0 || index >= partCount) {
+		return false;
+	}
+	LibreOfficeKitDocument *d = (LibreOfficeKitDocument *)doc;
+	if (!d->pClass->setPart) {
+		return false;
+	}
+	d->pClass->setPart(d, index);
+	return true;
+}
+
+bool HFRPpt::NextPart()
+{
+	if (!doc) {
+		return false;
+	}
+	LibreOfficeKitDocument *d = (LibreOfficeKitDocument *)doc;
+	/* 用 UNO 命令翻页：与 Impress 放映行为一致，也便于后续接动画步进 */
+	if (d->pClass->postUnoCommand) {
+		d->pClass->postUnoCommand(d, ".uno:NextPage", nullptr, false);
+		return true;
+	}
+	return SetPart(CurrentPart() + 1);
+}
+
+bool HFRPpt::PrevPart()
+{
+	if (!doc) {
+		return false;
+	}
+	LibreOfficeKitDocument *d = (LibreOfficeKitDocument *)doc;
+	if (d->pClass->postUnoCommand) {
+		d->pClass->postUnoCommand(d, ".uno:PreviousPage", nullptr, false);
+		return true;
+	}
+	return SetPart(CurrentPart() - 1);
+}
+
+bool HFRPpt::RenderCurrentPart(uint32_t w, uint32_t h, std::vector<uint8_t> &bgraOut, QString *errOut)
+{
+	if (!doc) {
+		lastError = QStringLiteral("尚未打开 PPT");
+		if (errOut) {
+			*errOut = lastError;
+		}
+		return false;
+	}
+	if (w == 0 || h == 0) {
+		return false;
+	}
+	LibreOfficeKitDocument *d = (LibreOfficeKitDocument *)doc;
+	if (!d->pClass->paintTile || !d->pClass->getDocumentSize) {
+		lastError = QStringLiteral("当前 LOK 版本缺少 paintTile/getDocumentSize");
+		if (errOut) {
+			*errOut = lastError;
+		}
+		return false;
+	}
+
+	long docW = 0, docH = 0;
+	d->pClass->getDocumentSize(d, &docW, &docH);
+	if (docW <= 0 || docH <= 0) {
+		lastError = QStringLiteral("取文档尺寸失败");
+		if (errOut) {
+			*errOut = lastError;
+		}
+		return false;
+	}
+
+	if (d->pClass->setClientZoom) {
+		/* 让 1 像素 ≈ 1 twip×zoom；这里用整数缩放保证整页映射 */
+		const int zoomNum = (int)w;
+		d->pClass->setClientZoom(d, zoomNum, (int)h, (int)docW, (int)docH);
+	}
+	if (d->pClass->setClientVisibleArea) {
+		d->pClass->setClientVisibleArea(d, 0, 0, (int)docW, (int)docH);
+	}
+
+	bgraOut.assign((size_t)w * h * 4, 0xFF);
+	d->pClass->paintTile(d, bgraOut.data(), (int)w, (int)h, 0, 0, (int)docW, (int)docH);
+	return true;
+}
+
+static void WriteBmp32(const QString &path, uint32_t w, uint32_t h, const std::vector<uint8_t> &bgra)
+{
+	const uint32_t rowBytes = w * 4;
+	const uint32_t imgSize = rowBytes * h;
+	const uint32_t fileSize = 54 + imgSize;
+	QFile f(path);
+	if (!f.open(QIODevice::WriteOnly | QIODevice::Truncate)) {
+		return;
+	}
+	uint8_t hdr[54] = {0};
+	hdr[0] = 'B';
+	hdr[1] = 'M';
+	memcpy(hdr + 2, &fileSize, 4);
+	uint32_t off = 54;
+	memcpy(hdr + 10, &off, 4);
+	uint32_t hdrSize = 40;
+	memcpy(hdr + 14, &hdrSize, 4);
+	memcpy(hdr + 18, &w, 4);
+	memcpy(hdr + 22, &h, 4);
+	uint16_t planes = 1, bpp = 32;
+	memcpy(hdr + 26, &planes, 2);
+	memcpy(hdr + 28, &bpp, 2);
+	memcpy(hdr + 34, &imgSize, 4);
+	f.write((const char *)hdr, 54);
+	/* BMP 行序自底向上：这里直接写（验证用途，翻不翻转都能看出内容） */
+	f.write((const char *)bgra.data(), (qint64)imgSize);
+	f.close();
+}
+
+bool HFRPpt::RenderToBmpForTest(uint32_t w, uint32_t h, const QString &bmpPath, QString *statsOut, QString *errOut)
+{
+	std::vector<uint8_t> buf;
+	if (!RenderCurrentPart(w, h, buf, errOut)) {
+		return false;
+	}
+	WriteBmp32(bmpPath, w, h, buf);
+
+	/* 统计：非白像素比例（判断是否真的渲染出内容，而不是空白页） */
+	size_t nonWhite = 0;
+	const size_t px = (size_t)w * h;
+	for (size_t i = 0; i < px; i++) {
+		const uint8_t b = buf[i * 4 + 0], g = buf[i * 4 + 1], r = buf[i * 4 + 2];
+		if (!(b > 245 && g > 245 && r > 245)) {
+			nonWhite++;
+		}
+	}
+	const double pct = px ? (100.0 * (double)nonWhite / (double)px) : 0.0;
+	if (statsOut) {
+		*statsOut = QStringLiteral("非白像素 %1%（%2x%3，第 %4/%5 页）")
+				    .arg(pct, 0, 'f', 2)
+				    .arg(w)
+				    .arg(h)
+				    .arg(CurrentPart() + 1)
+				    .arg(partCount);
+	}
+	return true;
+}
+
+#else /* !HFR_ENABLE_PPT */
+
+bool HFRPpt::EnsureLoaded(QString *errOut)
+{
+	lastError = QStringLiteral("本构建未启用 PPT 支持（重新配置时加 -DHFR_ENABLE_PPT=ON）");
+	if (errOut) {
+		*errOut = lastError;
+	}
+	return false;
