+#pragma once
+
+#include <QString>
+#include <cstdint>
+#include <vector>
+
+/* ============================================================
+ * HFRPpt —— 同进程 LibreOfficeKit（LOK）演示文档（pptx）渲染
+ * 设计要点（产品方要求）：
+ *   - 本地化部署 LibreOffice，**不走 IPC 桥接**：直接加载 program/mergedlo.dll，
+ *     通过导出符号 lok_preinit_2 取得 LibreOfficeKit*，同进程调用其 vtable。
+ *   - 动画：LOK 为静态渲染，一期按"每页最终状态"呈现（页间用自建转场）。
+ *   - 文字：按目标分辨率整页渲染；后续加"缺失字体报告/替换表"与 2x 超采样。
+ * 编译开关：HFR_ENABLE_PPT=ON 时才启用（未启用时接口返回失败并给出提示）。
+ * ============================================================ */
+class HFRPpt {
+public:
+	static HFRPpt &Instance();
+
+	/* LibreOffice 安装根目录（含 program/ 与 share/）；默认取环境变量 HFR_LO_PATH，
+	 * 否则用 D:/HuafeirongOBS/tools/LibreOffice */
+	static QString DefaultLoPath();
+
+	bool Enabled() const;
+	bool EnsureLoaded(QString *errOut);
+	bool OpenDocument(const QString &pptxPath, QString *errOut);
+	void CloseDocument();
+	bool IsOpen() const;
+
+	int PartCount() const;
+	int CurrentPart() const;
+	bool SetPart(int index);
+	bool NextPart();
+	bool PrevPart();
+
+	/* 整页渲染为 BGRA（每像素 4 字节，行序自顶向下）；w/h 为目标像素尺寸 */
+	bool RenderCurrentPart(uint32_t w, uint32_t h, std::vector<uint8_t> &bgraOut, QString *errOut);
+
+	QString LastError() const { return lastError; }
+
+	/* 便捷：渲染当前页并保存 BMP（用于人工验证），返回非白像素占比等统计 */
+	bool RenderToBmpForTest(uint32_t w, uint32_t h, const QString &bmpPath, QString *statsOut, QString *errOut);
+
+private:
+	HFRPpt() = default;
+	~HFRPpt();
+	HFRPpt(const HFRPpt &) = delete;
+	HFRPpt &operator=(const HFRPpt &) = delete;
+
+	QString lastError;
+	void *libHandle = nullptr;   /* HMODULE */
+	void *kit = nullptr;         /* LibreOfficeKit* */
+	void *doc = nullptr;         /* LibreOfficeKitDocument* */
+	QString openedPath;
+	int partCount = 0;
+};
