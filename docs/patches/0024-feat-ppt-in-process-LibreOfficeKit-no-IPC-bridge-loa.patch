+/* ---------------- PPT（同进程 LibreOfficeKit，无 IPC 桥接） ---------------- */
+
+static QString PptTestOutputDir()
+{
+	char *p = obs_frontend_get_current_profile_path();
+	QString dir = p ? QString::fromUtf8(p) : QString();
+	if (p) {
+		bfree(p);
+	}
+	if (dir.isEmpty()) {
+		dir = QDir::tempPath();
+	}
+	QDir().mkpath(dir);
+	return dir;
+}
+
+static void PptRenderAndReport(QLabel *status)
+{
+	HFRPpt &ppt = HFRPpt::Instance();
+	if (!ppt.IsOpen()) {
+		status->setText(QStringLiteral("PPT：尚未打开文件"));
+		return;
+	}
+	const QString out = PptTestOutputDir() + QStringLiteral("/hfr_ppt_preview.bmp");
+	QString stats, err;
+	if (ppt.RenderToBmpForTest(1280, 720, out, &stats, &err)) {
+		status->setText(QStringLiteral("PPT 渲染成功：%1 → %2").arg(stats).arg(out));
+	} else {
+		status->setText(QStringLiteral("PPT 渲染失败：%1").arg(err));
+	}
+}
+
+void HFRConsoleDock::PptOpenTest()
+{
+	const QString file = QFileDialog::getOpenFileName(this, QStringLiteral("选择 PPT 文件"), QString(),
+							  QStringLiteral("演示文稿 (*.pptx *.ppt *.odp);;所有文件 (*)"));
+	if (file.isEmpty()) {
+		return;
+	}
+	QString err;
+	HFRPpt &ppt = HFRPpt::Instance();
+	if (!ppt.OpenDocument(file, &err)) {
+		status->setText(QStringLiteral("PPT 打开失败：%1").arg(err));
+		return;
+	}
+	PptRenderAndReport(status);
+}
+
+void HFRConsoleDock::PptNext()
+{
+	HFRPpt &ppt = HFRPpt::Instance();
+	if (!ppt.IsOpen()) {
+		status->setText(QStringLiteral("PPT：尚未打开文件"));
+		return;
+	}
+	ppt.NextPart();
+	PptRenderAndReport(status);
+}
+
+void HFRConsoleDock::PptPrev()
+{
+	HFRPpt &ppt = HFRPpt::Instance();
+	if (!ppt.IsOpen()) {
+		status->setText(QStringLiteral("PPT：尚未打开文件"));
+		return;
+	}
+	ppt.PrevPart();
+	PptRenderAndReport(status);
+}
